config tiger 'server'
	option enabled            '0'
	option server             '[::]:8443'
	option udp_relay_ipv6     '1'
	option zero_rtt_handshake '0'
	option dual_stack         '1'
	option auth_timeout       '3'
	option stream_timeout     '60'
	option gc_interval        '10'
	option gc_lifetime        '30'

	# ── TLS ──
	option self_sign          '1'
	option hostname           'localhost'
	option certificate        ''
	option private_key        ''
	option auto_ssl           '0'
	option acme_email         ''

	# ── 用户 UUID 分组 ──
	# UUID 字段存放用户 UUID
	# password 字段存放用户密码
	# 支持多个用户，用数字后缀 _0 _1 _2 ...

	# ── QUIC ──
	option congestion_control 'bbr'
	option initial_mtu        '1200'
	option min_mtu            '1200'
	option send_window        '16777216'
	option receive_window     '8388608'
	option max_idle_time      '30'

	# ── RESTful API ──
	option restful_addr       ''
	option restful_secret     ''
	option max_clients        '0'

	# ── 防火墙 ──
	option manage_firewall    '1'

config user 'user0'
	option uuid   ''
	option password ''
