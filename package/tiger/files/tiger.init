#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1
PROG=/usr/bin/tuic-server
CONF=/etc/tuic/config.toml

_fw_rule_name() {
	local port="${1:-8443}"
	echo "tiger-${port}"
}

# 确保 rpcd 有 luci-app-tiger 的 ACL（每次启动都检查，防止恢复备份后丢失）
ensure_rpcd_acl() {
	local acl_name="luci-app-tiger"
	local acl_file="/usr/share/rpcd/acl.d/${acl_name}.json"
	[ -f "$acl_file" ] || return 0

	uci -q get rpcd.@rpcd[0].acl | grep -q "$acl_name" && return 0

	local acl
	acl=$(uci -q get rpcd.@rpcd[0].acl || "")
	uci set rpcd.@rpcd[0].acl="${acl} ${acl_name}"
	uci commit rpcd
	/etc/init.d/rpcd reload 2>/dev/null || true
}

add_firewall_rule() {
	local manage_firewall server_port
	config_get_bool manage_firewall server manage_firewall 0
	[ "$manage_firewall" -eq 1 ] || return 0

	# 从 server 地址提取端口
	local addr
	config_get addr server server '[::]:8443'
	server_port=$(echo "$addr" | grep -oE '[0-9]+$')
	[ -z "$server_port" ] && server_port=8443

	local name
	name="$(_fw_rule_name "$server_port")"

	# 避免重复添加
	uci show firewall | grep -q "name='${name}'" && return 0

	uci batch <<-EOF
		add firewall rule
		set firewall.@rule[-1].name='${name}'
		set firewall.@rule[-1].src='wan'
		set firewall.@rule[-1].dest_port='${server_port}'
		add_list firewall.@rule[-1].proto='udp'
		set firewall.@rule[-1].target='ACCEPT'
		commit firewall
	EOF
	/etc/init.d/firewall reload
}

remove_firewall_rule() {
	local section changed=0
	for section in $(uci show firewall | grep "name='tiger-" | cut -d. -f2); do
		uci delete "firewall.${section}"
		changed=1
	done
	[ "$changed" -eq 1 ] || return 0
	uci commit firewall
	/etc/init.d/firewall reload
}

# 每次启动（包括开机）都检查 ACL，然后启动服务
boot() {
	ensure_rpcd_acl
	start
}

start_service() {
	local enabled
	config_load tiger
	config_get_bool enabled server enabled 0

	[ "$enabled" -eq 1 ] || return 0

	/usr/libexec/tiger-ctrl.sh sync_config
	add_firewall_rule
	ensure_rpcd_acl

	procd_open_instance
	procd_set_param command /bin/sh
	procd_append_param command -c
	procd_append_param command "exec env NO_COLOR=1 $PROG -c $CONF >> /tmp/tiger.log 2>&1"
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

stop_service() {
	config_load tiger
	remove_firewall_rule
}

service_triggers() {
	procd_add_reload_trigger tiger
}

reload_service() {
	stop
	start
}
